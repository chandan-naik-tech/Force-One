# ── Force One backend configuration ─────────────────────────────
PORT=4000
NODE_ENV=development

# SQLite database file (created automatically). On a host, point this at a persistent disk/volume.
DATABASE_PATH=./data/forceone.db

# Auth — change both before going live
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@forceone.local
ADMIN_PASSWORD=choose-a-strong-password

# Media storage. Leave S3_BUCKET empty to save uploads in backend/uploads (development only).
# For production fill these in (Cloudflare R2 / AWS S3 / Backblaze B2 / Supabase Storage):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
